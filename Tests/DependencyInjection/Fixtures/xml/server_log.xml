<?xml version="1.0" encoding="UTF-8" ?>

<!-- TODO: After updating the monolog-1.0.xsd file, put "http://symfony.com/schema/dic/monolog http://symfony.com/schema/dic/monolog/monolog-1.0.xsd" back in xsi:schemaLocation -->
<container xmlns="http://symfony.com/schema/dic/services"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:monolog="http://symfony.com/schema/dic/monolog"
    xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <monolog:config>
        <monolog:handler name="server_log">
            <monolog:type_server_log host="0:9911"/>
        </monolog:handler>
    </monolog:config>
</container>
